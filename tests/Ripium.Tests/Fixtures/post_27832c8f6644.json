l,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null}],"quoteType":null}],"responsesLocked":false,"tags":[{"__typename":"Tag","id":"wasting-time","normalizedTagSlug":"wasting-time","displayTitle":"Wasting Time","followerCount":25,"postCount":232},{"__typename":"Tag","id":"self-improvement","normalizedTagSlug":"self-improvement","displayTitle":"Self Improvement","followerCount":13520898,"postCount":935104},{"__typename":"Tag","id":"distraction","normalizedTagSlug":"distraction","displayTitle":"Distraction","followerCount":69,"postCount":3956},{"__typename":"Tag","id":"addiction","normalizedTagSlug":"addiction","displayTitle":"Addiction","followerCount":281792,"postCount":42478},{"__typename":"Tag","id":"time-management","normalizedTagSlug":"time-management","displayTitle":"Time Management","followerCount":12962,"postCount":47542}],"content":{"bodyModel":{"__typename":"RichText","sections":[{"__typename":"Section","name":"c47e","startIndex":0,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null}],"paragraphs":[{"__typename":"Paragraph","id":"28d5dfba8fb9_0","name":"2592","href":null,"text":"Stop Wasting Your Life","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H3","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_1","name":"936d","href":null,"text":"","iframe":null,"layout":"INSET_CENTER","markups":[],"metadata":{"__typename":"ImageMetadata","id":"1*g6_rwCXG8HuOBKVI-NM3Qw.jpeg","originalWidth":568,"originalHeight":346,"focusPercentX":null,"focusPercentY":null,"alt":null},"mixtapeMetadata":null,"type":"IMG","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_2","name":"5e3a","href":null,"text":"I want you to use your imagination for a second.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_3","name":"cdce","href":null,"text":"I don’t know who you are or what you do.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_4","name":"378a","href":null,"text":"But I’m going to assume you’re someone who suffers from distractions.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_5","name":"0226","href":null,"text":"I do too.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_6","name":"811c","href":null,"text":"In fact, most of the world does.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_7","name":"81ac","href":null,"text":"Especially if you have the luxury of being able to use modern technology.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_8","name":"c4a9","href":null,"text":"","iframe":null,"layout":"INSET_CENTER","markups":[],"metadata":{"__typename":"ImageMetadata","id":"1*oZrSp2LjHTggs1Jy3WCuZw.jpeg","originalWidth":799,"originalHeight":599,"focusPercentX":null,"focusPercentY":null,"alt":null},"mixtapeMetadata":null,"type":"IMG","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_9","name":"387c","href":null,"text":"It’s a gift, yet also a curse.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_10","name":"edf3","href":null,"text":"But here’s the problem.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_11","name":"99ca","href":null,"text":"If you don’t get a grip of yourself, you’re going to waste the most precious time you currently have.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_12","name":"0dea","href":null,"text":"This message is as relevant to you as it is to me.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_13","name":"42ad","href":null,"text":"I want you to feel inspired after reading this article.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_14","name":"a9cc","href":null,"text":"Because life is inspiring.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_15","name":"d06e","href":null,"text":"And we’d be fools not to make the most of it.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_16","name":"9eb0","href":null,"text":"10,000 hours","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_17","name":"9bda","href":null,"text":"Let’s talk about the 10,000 hour rule.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_18","name":"bd05","href":null,"text":"This idea was made famous by the author Malcolm Gladwell.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_19","name":"7979","href":null,"text":"His argument is that it takes 10,000 hours of intense focus to achieve mastery in any field.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_20","name":"2dc9","href":null,"text":"We won’t poke holes in the specific numbers.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_21","name":"4df2","href":null,"text":"I think this is a fairly safe estimate.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_22","name":"b2e2","href":null,"text":"So, how long is 10,000 hours?","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_23","name":"b3e1","href":null,"text":"It is roughly 417 days.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_24","name":"41f7","href":null,"text":"60 weeks.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_25","name":"432b","href":null,"text":"14 months.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_26","name":"9f43","href":null,"text":"In other words, just over a year.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_27","name":"98ae","href":null,"text":"With that said, you aren’t going to spend an entire year just doing one thing.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_28","name":"e229","href":null,"text":"You need to eat.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_29","name":"b645","href":null,"text":"You need to sleep.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_30","name":"58d0","href":null,"text":"You need to engage in other activities that make the human experience worthwhile.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_31","name":"dedb","href":null,"text":"But one of the main things you should be doing with your time is mastering a skill.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_32","name":"b9ef","href":null,"text":"It doesn’t matter what it is necessarily, but sadly, some skills are more valuable than others.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_33","name":"cf2a","href":null,"text":"This is why it’s important to pick something that can be monetizable.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_34","name":"99cd","href":null,"text":"","iframe":null,"layout":"INSET_CENTER","markups":[],"metadata":{"__typename":"ImageMetadata","id":"1*_1K1tlANg11JxtVyjNDR4Q.jpeg","originalWidth":3600,"originalHeight":2380,"focusPercentX":null,"focusPercentY":null,"alt":null},"mixtapeMetadata":null,"type":"IMG","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_35","name":"ef53","href":null,"text":"You might love surfing more than life itself.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_36","name":"cead","href":null,"text":"That is a passion which can be turned into a business.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_37","name":"19d7","href":null,"text":"The only problem is, your potential would be limited because of the nature of the niche.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_38","name":"dae1","href":null,"text":"Whereas if you chose to pursue marketing as your passion, your earning potential is literally unlimited.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_39","name":"28a5","href":null,"text":"Why?","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_40","name":"f21c","href":null,"text":"Because someone who’s good at marketing is more valuable than someone who can catch a big wave (in the eyes of businesses).","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_41","name":"2e75","href":null,"text":"Sorry, but it’s true.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_42","name":"475e","href":null,"text":"Either way, it’s important you find the skill you want to master as fast as possible.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_43","name":"790a","href":null,"text":"You can’t afford to waste any time.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_44","name":"f924","href":null,"text":"Distractions","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_45","name":"180c","href":null,"text":"We’re plagued by distractions.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_46","name":"bcb7","href":null,"text":"Every TV channel is hoping to keep your attention hostage.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_47","name":"87e0","href":null,"text":"Every single website and social media app is designed to keep you on their platforms for as long as possible.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_48","name":"45e0","href":null,"text":"Your video games are addictive and constantly occupy your thoughts.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_49","name":"b95c","href":null,"text":"Accurate.","iframe":null,"layout":"INSET_CENTER","markups":[],"metadata":{"__typename":"ImageMetadata","id":"1*oUfs_B0RSwIZr3_hHqNkYw.jpeg","originalWidth":521,"originalHeight":391,"focusPercentX":null,"focusPercentY":null,"alt":null},"mixtapeMetadata":null,"type":"IMG","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_50","name":"b13c","href":null,"text":"In short, we’re in trouble.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_51","name":"bb8c","href":null,"text":"But the good news is, we’re not doomed.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_52","name":"7e96","href":null,"text":"There are things you can do to limit distractions.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_53","name":"d65d","href":null,"text":"It’s not easy, but is definitely doable.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_54","name":"d75a","href":null,"text":"The key at the start isn’t to add positive habits.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_55","name":"28e7","href":null,"text":"You first need to start removing bad habits.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_56","name":"0a7b","href":null,"text":"You can start by leaving your phone outside your bedroom at night.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_57","name":"c458","href":null,"text":"Then gradually move to deleting apps.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_58","name":"7473","href":null,"text":"Maybe even selling your television.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_59","name":"ba84","href":null,"text":"These may seem like extreme suggestions to you, and if you want these things in your life, you can keep them.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_60","name":"ba76","href":null,"text":"All I’m saying is, you can’t afford to be distracted.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_61","name":"0cc7","href":null,"text":"You can’t be one of those people who wastes 10,000 hours.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_62","name":"8e0f","href":null,"text":"And then has the audacity to say you didn’t have time.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_63","name":"8757","href":null,"text":"You did have time.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_64","name":"d877","href":null,"text":"You just wasted it on crap that doesn’t matter.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_65","name":"e3b1","href":null,"text":"Youngster","iframe":null,"layout":"INSET_CENTER","markups":[],"metadata":{"__typename":"ImageMetadata","id":"1*_1w4mn-wtOztgnkKCYDz8Q.jpeg","originalWidth":612,"originalHeight":408,"focusPercentX":null,"focusPercentY":null,"alt":null},"mixtapeMetadata":null,"type":"IMG","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_66","name":"0044","href":null,"text":"You may feel like you can afford to waste time right now.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_67","name":"0a43","href":null,"text":"You’re young, right?","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_68","name":"1813","href":null,"text":"You’ll have time 5 years from now.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_69","name":"a02b","href":null,"text":"But here’s the problem.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_70","name":"63a4","href":null,"text":"If you don’t start building now, 5 years is going to fly by.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_71","name":"3c8f","href":null,"text":"I mean it.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_72","name":"f028","href":null,"text":"I’m 24 now.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_73","name":"d44e","href":null,"text":"And turning 25 in April.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_74","name":"3589","href":null,"text":"But I still remember being 18 as if it was yesterday.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_75","name":"a049","href":null,"text":"But it wasn’t yesterday.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_76","name":"4e68","href":null,"text":"It was 6 years ago.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_77","name":"4caa","href":null,"text":"Back then I thought I had time to waste, so I did.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_78","name":"b6b3","href":null,"text":"I became a drug addict.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_79","name":"4e31","href":null,"text":"I spent hours everyday binging bad shows on Netflix.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_80","name":"082a","href":null,"text":"I went out every night drinking and partying.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_81","name":"cc07","href":null,"text":"Now I look back at all the wasted time and regret every second of it.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_82","name":"9265","href":null,"text":"I don’t want you to make the same mistakes.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_83","name":"a510","href":null,"text":"I’m lucky I was able to snap out of it.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_84","name":"5ac9","href":null,"text":"But it took me a while.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_85","name":"f2b4","href":null,"text":"I didn’t get my life in order until I was 22.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_86","name":"79d7","href":null,"text":"That’s right, I spent 4 years of my life wasting away.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_87","name":"c1be","href":null,"text":"4 years, gone in a flash and with nothing to show for it.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_88","name":"3cc8","href":null,"text":"Don’t make this mistake.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_89","name":"f79a","href":null,"text":"You’ll regret it for the rest of your life.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_90","name":"d64c","href":null,"text":"It doesn’t matter how old you are right now.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_91","name":"f574","href":null,"text":"You could be 15, or you could be 30.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_92","name":"f8ac","href":null,"text":"Stop everything you’re doing in the present and start looking towards your future.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_93","name":"429d","href":null,"text":"I’m lucky to still be quite young.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_94","name":"bd26","href":null,"text":"If I hadn’t woken up until I was 30, I’d be in big trouble.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_95","name":"7916","href":null,"text":"Now that I’m aware of how precious time is, I’m confident I’ll be a millionaire by 30.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_96","name":"3af7","href":null,"text":"Why?","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_97","name":"8088","href":null,"text":"What a cutie!","iframe":null,"layout":"INSET_CENTER","markups":[],"metadata":{"__typename":"ImageMetadata","id":"1*RGUW9ZnS-wH7jktaBQIMdw.jpeg","originalWidth":1280,"originalHeight":720,"focusPercentX":null,"focusPercentY":null,"alt":null},"mixtapeMetadata":null,"type":"IMG","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"28d5dfba8fb9_98","name":"69d8",