{"__typename":"Post","id":"9dc802a10618","readingTime":7.1644654088050315,"creator":{"__typename":"User","id":"f649eccbbc3d","imageId":"1*e5vvQy18x_zm25RbCFLCaA@2x.jpeg","username":"lynn-kwong","name":"Lynn G. Kwong","bio":"I’m a Software Developer (https://lynn-kwong.medium.com/) keen on sharing thoughts, tutorials, and solutions for the best practice of software development.","tippingLink":"https://ko-fi.com/kwonglynn","viewerEdge":{"isUser":false,"isFollowing":false,"isBlocking":false,"isMuting":false},"socialStats":{"followingCount":374,"followerCount":1806},"newsletterV3":{"__typename":"NewsletterV3","id":"7ded617010a1","viewerEdge":{"id":"newsletterId:7ded617010a1-viewerId:lo_c64d2492d430","isSubscribed":false}},"isFollowing":null,"mediumMemberAt":1764351631046,"twitterScreenName":"kwonglynn"},"collection":{"__typename":"Collection","id":"5517fd7b58a6","name":"Level Up Coding","avatar":{"__typename":"ImageMetadata","id":"1*5D9oYBd58pyjMkV_5-zXXQ.jpeg","originalWidth":400,"originalHeight":400,"focusPercentX":null,"focusPercentY":null,"alt":null},"subscriberCount":370594,"viewerEdge":{"isFollowing":false,"isEditor":false,"canEditPosts":false,"canEditOwnPosts":false,"isMuting":false},"newsletterV3":{"__typename":"NewsletterV3","id":"73ee478940e7","viewerEdge":{"id":"newsletterId:73ee478940e7-viewerId:lo_c64d2492d430","isSubscribed":false}},"slug":"gitconnected","shortDescription":"Coding tutorials and news."},"isLocked":true,"firstPublishedAt":1670119389899,"latestPublishedVersion":"86078be80e84","title":"Some Linux Commands That Can Boost Your Work Efficiency Dramatically","visibility":"LOCKED","postResponses":{"count":3},"clapCount":211,"viewerEdge":{"clapCount":0},"detectedLanguage":"en","mediumUrl":"https://levelup.gitconnected.com/some-linux-commands-that-can-boost-your-work-efficiency-dramatically-9dc802a10618","updatedAt":1699994694394,"allowResponses":true,"isProxyPost":false,"isSeries":false,"previewImage":{"id":"0*jamI-nfmp62PdWZh"},"inResponseToPostResult":null,"inResponseToMediaResource":null,"inResponseToEntityType":null,"canonicalUrl":"https://levelup.gitconnected.com/some-linux-commands-that-can-boost-your-work-efficiency-dramatically-9dc802a10618","previewContent":{"subtitle":"Learn some handy and advanced Linux commands from practical examples"},"pinnedByCreatorAt":0,"linkMetadataList":[{"url":"https://lynn-kwong.medium.com/build-a-docker-image-with-cloud-build-in-google-cloud-platform-5f6840af2c05","alts":[{"type":"ANDROID_APPLINK","url":"medium://p/5f6840af2c05"},{"type":"IOS_APPLINK","url":"medium://p/5f6840af2c05"}]},{"url":"https://twitter.com/gitconnected","alts":[]},{"url":"https://newsletter.levelup.dev","alts":[]},{"url":"https://levelup.gitconnected.com/?utm_source=pub&utm_medium=post","alts":[{"type":"IOS_APPLINK","url":"medium://gitconnected"},{"type":"ANDROID_APPLINK","url":"medium://gitconnected"}]},{"url":"https://medium.com/geekculture/common-vim-commands-and-operations-that-i-want-to-share-3b7fbc3d7ee9","alts":[{"type":"IOS_APPLINK","url":"medium://p/3b7fbc3d7ee9"},{"type":"ANDROID_APPLINK","url":"medium://p/3b7fbc3d7ee9"}]},{"url":"https://wiki.archlinux.org/title/Bash/Prompt_customization","alts":[]},{"url":"https://www.linkedin.com/company/gitconnected","alts":[{"type":"ANDROID_APPLINK","url":"https://www.linkedin.com/company/gitconnected"},{"type":"IOS_APPLINK","url":"https://www.linkedin.com/company/gitconnected"}]},{"url":"https://jobs.levelup.dev/talent/welcome?referral=true","alts":[]}],"highlights":[],"responsesLocked":false,"tags":[{"__typename":"Tag","id":"linux","normalizedTagSlug":"linux","displayTitle":"Linux","followerCount":17295,"postCount":50770},{"__typename":"Tag","id":"ubuntu","normalizedTagSlug":"ubuntu","displayTitle":"Ubuntu","followerCount":2001,"postCount":12692},{"__typename":"Tag","id":"shell","normalizedTagSlug":"shell","displayTitle":"Shell","followerCount":438,"postCount":3352},{"__typename":"Tag","id":"commands","normalizedTagSlug":"commands","displayTitle":"Commands","followerCount":40,"postCount":1180},{"__typename":"Tag","id":"efficiency","normalizedTagSlug":"efficiency","displayTitle":"Efficiency","followerCount":162,"postCount":8638}],"content":{"bodyModel":{"__typename":"RichText","sections":[{"__typename":"Section","name":"3c13","startIndex":0,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"29d1","startIndex":5,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"c8c3","startIndex":11,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"9045","startIndex":21,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"73eb","startIndex":24,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"0183","startIndex":28,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"724d","startIndex":31,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"4b75","startIndex":43,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"2f22","startIndex":47,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"f6f8","startIndex":54,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"884a","startIndex":58,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"2f53","startIndex":65,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"ad0a","startIndex":66,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null},{"__typename":"Section","name":"6ba5","startIndex":69,"textLayout":null,"imageLayout":null,"videoLayout":null,"backgroundImage":null,"backgroundVideo":null}],"paragraphs":[{"__typename":"Paragraph","id":"86078be80e84_0","name":"96e7","href":null,"text":"Some Linux Commands That Can Boost Your Work Efficiency Dramatically","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H3","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_1","name":"e44e","href":null,"text":"Learn some handy and advanced Linux commands from practical examples","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_2","name":"5ebb","href":null,"text":"Image by Gabriel Heinzer (sudo) in Unsplash","iframe":null,"layout":"INSET_CENTER","markups":[],"metadata":{"__typename":"ImageMetadata","id":"0*jamI-nfmp62PdWZh","originalWidth":1000,"originalHeight":750,"focusPercentX":null,"focusPercentY":null,"alt":null},"mixtapeMetadata":null,"type":"IMG","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_3","name":"718f","href":null,"text":"As a software developer, Linux commands are a must-have technique. Even though you may use Windows or macOS, you will always find occasions when Linux commands are needed. For example, most Docker images are based on Linux systems. You need to be good at Linux, at least some common commands, to carry out DevOps work.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_4","name":"1808","href":null,"text":"In this post, I will introduce some commands that I use every day. This post can be helpful if you are new to Linux or if you want to refresh or improve or knowledge of Linux commands. However, this post won’t focus on the very fundamentals like cd or ls, but some more advanced ones learned from practice.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":246,"end":248,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":252,"end":254,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_5","name":"5f2c","href":null,"text":"Customize bash prompt","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_6","name":"f59b","href":null,"text":"Well, this topic can itself be a lengthy post. However, we don’t need to learn everything. In most cases, we just need to change the PS1 variable which specifies what is displayed before each command. If you don’t change it, it will show the path in the prompt, which is very inconvenient when we are deep inside a folder. I prefer to only show the user name and the current folder in the prompt, which can be set with this command:","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":"","type":"CODE","start":133,"end":136,"href":"","title":"","rel":"","anchorType":"LINK","userId":"","creatorIds":[]}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_7","name":"583e","href":null,"text":"export PS1=\"[\\u@\\W]\\$\"","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"AUTO"}},{"__typename":"Paragraph","id":"86078be80e84_8","name":"c11f","href":null,"text":"Here \\u represents the current user name and \\W the current working directory. [, ], and @ are shown as they are. For \\$ , $ will be shown if the current user is not root, otherwise, # will be shown.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":5,"end":7,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":45,"end":47,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":79,"end":80,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":82,"end":83,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":89,"end":90,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":118,"end":120,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":123,"end":124,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":183,"end":184,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_9","name":"b99c","href":null,"text":"Note, this command and the ones shown below should be added to ~/.bashrc if you want to persist with the changes.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":63,"end":72,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_10","name":"15ac","href":null,"text":"If you want to customize other prompt strings like PS0, PS2, PS3, etc., please refer to this post.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":51,"end":54,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":56,"end":59,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":61,"end":64,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"A","start":88,"end":97,"href":"https://wiki.archlinux.org/title/Bash/Prompt_customization","title":"","rel":"noopener","anchorType":"LINK","userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_11","name":"76e5","href":null,"text":"Find files or folders","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_12","name":"8c72","href":null,"text":"It’s a very common request to find files or folders, which can be done by the find command:","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":78,"end":82,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_13","name":"a6a0","href":null,"text":"# Find a file:\nfind ~ -type f -name data-model.ts\n\n# Find a folder:\nfind ~ -type d -name angular15","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"AUTO"}},{"__typename":"Paragraph","id":"86078be80e84_14","name":"bcf1","href":null,"text":"Note that the first parameter is the path to find the target file or folder. The type is defaulted to everything if not specified.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_15","name":"0169","href":null,"text":"It seems a bit too simple 😏. Let’s do something a bit more complex. Let’s find some files and count the number of lines for each file:","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_16","name":"dcf9","href":null,"text":"# Find all the .html files and count the number of lines for each file:\nfind src/app/ -name \"*.html\" -exec wc -l {} \\;","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"AUTO"}},{"__typename":"Paragraph","id":"86078be80e84_17","name":"f9e8","href":null,"text":"Note the magic syntax here. The -exec specifies a command to run for each file found. The curly brackets {} is a placeholder for the file found and the escaped semicolon \\; is used as a delimiter that marks the end of the command to be executed for each file found by find.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":32,"end":37,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":105,"end":107,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":170,"end":172,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":268,"end":272,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"EM","start":9,"end":14,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_18","name":"9970","href":null,"text":"We can also use a plus sign + for this purpose as well:","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":28,"end":29,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_19","name":"b43a","href":null,"text":"find src/app/ -name \"*.html\" -exec wc -l {} +","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"AUTO"}},{"__typename":"Paragraph","id":"86078be80e84_20","name":"97ed","href":null,"text":"The output will be slightly different. The total will be printed if the command ends with +.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":"","type":"CODE","start":90,"end":91,"href":"","title":"","rel":"","anchorType":"LINK","userId":"","creatorIds":[]}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_21","name":"9f06","href":null,"text":"Change permissions of files and folders","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_22","name":"2cd2","href":null,"text":"It’s also a common task to change file/folder permissions. And we can easily get confused with the permission codes. Here we will only demonstrate the most common ones:","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_23","name":"d8ac","href":null,"text":"# Share a folder with others so they can check the contents in the folder:\nchmod 755 <path-to-your-folder>\n\n# Share a non-executable file with others:\nchmod 644 <path-to-your-file>\n\n# Share an executable file with others:\nchmod 755 <path-to-your-file>\n\n# Make a file read only:\nchmod 400 <path-to-your-file>\n\n# Make a file executable:\nchmod +x <path-to-your-file>","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"AUTO"}},{"__typename":"Paragraph","id":"86078be80e84_24","name":"ecef","href":null,"text":"Custom rm to move files to Trash","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":7,"end":9,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_25","name":"c5cd","href":null,"text":"If you accidentally remove some files on a Linux system, it will be very difficult to restore them. Therefore, it’s a safe strategy to set the rm command to move files or folders to the Trash rather than to delete them. We can empty the Trash when needed later.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":143,"end":145,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_26","name":"1c55","href":null,"text":"This customization can be done with aliasing, which is a very handy tool on Linux (more on this later):","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_27","name":"56ef","href":null,"text":"alias rm='gio trash'","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"AUTO"}},{"__typename":"Paragraph","id":"86078be80e84_28","name":"835a","href":null,"text":"Use aliases to save some typing","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_29","name":"7180","href":null,"text":"If you have a long command with a lot of parameters or if you have chained commands which should be executed together, using an alias is very convenient:","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_30","name":"5061","href":null,"text":"# Set aliases for long commands:\nalias dc=\"docker compose\"\nalias prettier=\"npx prettier -w\"\nalias eslint=\"npx eslint --fix\"\nalias pre=\"pre-commit run --files\"\n\n# Chain some commands together:\nalias update-container=\"docker-compose pull <service-name> && docker-compose stop <service-name> && yes | docker-compose rm <service-name> && docker-compose up -d <service-name>\"","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"EXPLICIT"}},{"__typename":"Paragraph","id":"86078be80e84_31","name":"cdbd","href":null,"text":"Extracting data from input with awk","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":32,"end":35,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_32","name":"17fe","href":null,"text":"awk is a very powerful tool in Linux. You can even write scripts with awk, though the issue of readability and maintenance is another story. As software developers, we normally use awk to get the field we need from the input file or output of a previous command.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":0,"end":3,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":70,"end":73,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":181,"end":184,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_33","name":"b540","href":null,"text":"For example, let’s ping google.com and get the time for each ping:","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"EM","start":19,"end":23,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_34","name":"57fc","href":null,"text":"ping google.com -c 2 | grep -iE 'time=.*ms' | awk 'BEGIN {FS=\"=\"} {print $NF}'","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"perl","mode":"AUTO"}},{"__typename":"Paragraph","id":"86078be80e84_35","name":"f9f2","href":null,"text":"Important notes for this command:","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_36","name":"a635","href":null,"text":"We use -iE to specify a regular expression for grep, so only the messages matched by the pattern will be further processed.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":7,"end":10,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":47,"end":51,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"ULI","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_37","name":"b263","href":null,"text":"For awk, BEGIN species the command to be executed before the text is processed. Here, we specify that the field separator (FS) should be an equal sign. Besides, NF stands for the number of fields and $NF will return the last field.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":4,"end":7,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":9,"end":14,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":123,"end":125,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":161,"end":163,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":200,"end":203,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"ULI","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_38","name":"7735","href":null,"text":"The above command can also be simplified as follows:","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_39","name":"5c6f","href":null,"text":"ping google.com -c 2 | grep -iE 'time=.*ms' | awk -F\"=\" '{print $NF}'\nping google.com -c 2 | awk -F\"=\" '/time=.*ms/ {print $NF}'","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"dart","mode":"AUTO"}},{"__typename":"Paragraph","id":"86078be80e84_40","name":"d5ac","href":null,"text":"In these simplified versions, we make use of another two features of awk:","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":69,"end":72,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_41","name":"bf39","href":null,"text":"The field separator can be specified directly with the -F option.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":55,"end":57,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"ULI","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_42","name":"0cee","href":null,"text":"The regular expression pattern can be specified in awk as well before the curly brackets.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":51,"end":54,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"ULI","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_43","name":"4b8c","href":null,"text":"Build commands with xargs","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_44","name":"a873","href":null,"text":"We have shown the -exec option can be used to build commands for the find command. A better tool is xargs which can be used to build any command in a more flexible way.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":18,"end":23,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":69,"end":73,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":100,"end":105,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_45","name":"ddf2","href":null,"text":"# Check the size of each file in the current folder:\nls | xargs -I % du -sh %\n\n# Find some files and copy them to a new location:\nfind ~/Downloads/ -name \"*.jpeg\" | xargs -I {} cp {} ~/Pictures/\n\n# Change the permissions of all folders and subfolders to 755:\nfind . -type d | xargs -I {} chmod 755 {}\n\n# Change the permissions of all files in the current folder and subfolders to 644:\nfind . -type f | xargs -I {} chmod 644 {}","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"AUTO"}},{"__typename":"Paragraph","id":"86078be80e84_46","name":"0721","href":null,"text":"Note that, the -I (--replace=) option specifies a placeholder that can be used wherever needed. The placeholder can be any valid string with % and {} being the most common ones.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":15,"end":17,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":19,"end":29,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":141,"end":142,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":147,"end":149,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_47","name":"502c","href":null,"text":"Setting environment variables for a script","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_48","name":"49c6","href":null,"text":"Sometimes we need to set some environment variables for a script. Those variables can be specified on the command line before the command runs the script. For example:","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_49","name":"5f69","href":null,"text":"# some_script.sh\necho mysql -u ${USERNAME} -p${PASSWORD}\n\n# On the command line:\nUSERNAME=johndoe PASSWORD=12345 bash some_script.sh","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"EXPLICIT"}},{"__typename":"Paragraph","id":"86078be80e84_50","name":"1f56","href":null,"text":"This is especially important for some scripts running in some Cloud environments such as Cloud Build where the variables can be injected automatically.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_51","name":"0e86","href":null,"text":"If many variables are required for a script, it becomes cumbersome to specify all of them on the command line. In this case, they can be stored in a file and get read and set when running the script:","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_52","name":"fb79","href":null,"text":"# variables.env\nUSERNAME=johndoe\nPASSWORD=12345\n\n# On the command line:\nenv $(grep -v '^#' variables.env | xargs) bash some_script.sh","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"EXPLICIT"}},{"__typename":"Paragraph","id":"86078be80e84_53","name":"ed5c","href":null,"text":"Note that with this command, the variables are read from the target file (excluding comments) and executed with the xargs command. The env command is used to run the script in a modified environment, rather than the current shell environment.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":116,"end":121,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"CODE","start":135,"end":138,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_54","name":"8cbd","href":null,"text":"Redirect STDOUT and STDERR","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_55","name":"7e13","href":null,"text":"The output and error of a command are written to the standard out (STDOUT) and standard error (STDERR). The file descriptors for STDOUT and STDERR are 1 and 2, respectively. By default, both STDOUT and STDERR go to the console. However, we can redirect them to a file or to void (/dev/null) meaning discarding them.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":281,"end":289,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_56","name":"6f24","href":null,"text":"# Let's assume existing.txt exists, whereas non-existing.txt does not.\n\n# Redirect STDOUT to a file. This is the most common use case.\nls -al existing.txt 1>out.log\n# The file descriptor for STDOUT is optional.\nls -al existing.txt >out.log\n\n# Redirect STDOUT to a file and STDOUT to another file.\nls -al existing.txt non-existing.txt 1>out.log 2>error.log\n\n# Rdirect both STDOUT and STDERR to the same file:\nls -al existing.txt non-existing.txt 1>combined.log 2>&1\n# And it can be simplified as:\nls -al existing.txt non-existing.txt &>combined.log\n\n# Ignore the output and error of the command:\nls -al existing.txt non-existing.txt 1>/dev/null 2>&1\nls -al existing.txt non-existing.txt &>/dev/null","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"EXPLICIT"}},{"__typename":"Paragraph","id":"86078be80e84_57","name":"3c89","href":null,"text":"Note that the &> syntax is not supported by all the shells. It’s supported by BASH which is commonly used.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"CODE","start":14,"end":16,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_58","name":"d1af","href":null,"text":"Command-line fuzzy finder","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_59","name":"0ecb","href":null,"text":"We can press CTRL-R to find the historical commands we have used. However, by default, it only displays one command when we type, which is not convenient to find the one we want.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"STRONG","start":12,"end":19,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_60","name":"7dc7","href":null,"text":"Luckily, fzf enhanced the function of CTRL-R dramatically. fzf is a general-purpose command-line fuzzy finder and enables fuzzy searches of historical commands. And most importantly, it displays the matching commands as a list which makes it extremely convenient to find the one we want:","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"STRONG","start":9,"end":12,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"EM","start":9,"end":12,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"EM","start":59,"end":62,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_61","name":"4d73","href":null,"text":"","iframe":null,"layout":"INSET_CENTER","markups":[],"metadata":{"__typename":"ImageMetadata","id":"1*066OGJ8E2E5zCVhFQsSUqw.png","originalWidth":713,"originalHeight":195,"focusPercentX":null,"focusPercentY":null,"alt":null},"mixtapeMetadata":null,"type":"IMG","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_62","name":"0c46","href":null,"text":"The installation of fzf is very simple:","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"EM","start":20,"end":23,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_63","name":"8d85","href":null,"text":"# Linux:\ngit clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf\n~/.fzf/install  # You can accept all the default settings.\n\n# MacOS:\nbrew install fzf\n$(brew --prefix)/opt/fzf/install","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"PRE","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":{"lang":"bash","mode":"AUTO"}},{"__typename":"Paragraph","id":"86078be80e84_64","name":"b7d5","href":null,"text":"If you have never tried fzf before, it’s definitely worth a shot and you will love it immediately 😍.","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"EM","start":24,"end":27,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_65","name":"0e4b","href":null,"text":"In this post, some handy Linux commands are introduced which can boost your efficiency if you don’t know them already. It’s impossible to cover all the Linux commands in a single post. However, we don’t need to learn everything and normally only need to learn what’s actually needed in our work. I hope this post can be a helpful reference for your work.","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_66","name":"14e9","href":null,"text":"Related article:","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H4","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_67","name":"935b","href":null,"text":"Learn Handy Vim Commands and Operations That Can Increase Your Efficiency Dramatically","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"A","start":0,"end":86,"href":"https://medium.com/geekculture/common-vim-commands-and-operations-that-i-want-to-share-3b7fbc3d7ee9","title":"","rel":"","anchorType":"LINK","userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"ULI","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_68","name":"a04f","href":null,"text":"Build a Docker image automatically with Cloud Build in Google Cloud Platform","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"A","start":0,"end":76,"href":"https://lynn-kwong.medium.com/build-a-docker-image-with-cloud-build-in-google-cloud-platform-5f6840af2c05","title":"","rel":"","anchorType":"LINK","userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"ULI","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_69","name":"ca10","href":null,"text":"Level Up Coding","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"H3","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_70","name":"cde2","href":null,"text":"Thanks for being a part of our community! Before you go:","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_71","name":"1f67","href":null,"text":"👏 Clap for the story and follow the author 👉","iframe":null,"layout":null,"markups":[],"metadata":null,"mixtapeMetadata":null,"type":"ULI","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_72","name":"e164","href":null,"text":"📰 View more content in the Level Up Coding publication","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"A","start":28,"end":55,"href":"https://levelup.gitconnected.com/?utm_source=pub&utm_medium=post","title":"","rel":"","anchorType":"LINK","userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"ULI","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_73","name":"0075","href":null,"text":"🔔 Follow us: Twitter | LinkedIn | Newsletter","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"A","start":14,"end":21,"href":"https://twitter.com/gitconnected","title":"","rel":"","anchorType":"LINK","userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"A","start":24,"end":32,"href":"https://www.linkedin.com/company/gitconnected","title":"","rel":"","anchorType":"LINK","userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"A","start":35,"end":45,"href":"https://newsletter.levelup.dev","title":"","rel":"","anchorType":"LINK","userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"ULI","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null},{"__typename":"Paragraph","id":"86078be80e84_74","name":"e87e","href":null,"text":"🚀👉 Join the Level Up talent collective and find an amazing job","iframe":null,"layout":null,"markups":[{"__typename":"Markup","name":null,"type":"A","start":5,"end":64,"href":"https://jobs.levelup.dev/talent/welcome?referral=true","title":"","rel":"","anchorType":"LINK","userId":null,"creatorIds":null},{"__typename":"Markup","name":null,"type":"STRONG","start":5,"end":64,"href":null,"title":null,"rel":null,"anchorType":null,"userId":null,"creatorIds":null}],"metadata":null,"mixtapeMetadata":null,"type":"P","hasDropCap":null,"dropCapImage":null,"codeBlockMetadata":null}]},"validatedShareKey":""}}